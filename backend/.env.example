# VeriStream: Real-Time Multimodal Fact Verification Engine
# FastAPI Configuration

HOST=0.0.0.0
PORT=8000
DEBUG=True

# OpenAI API Key (For Whisper Speech-to-Text & LLM Agent Reasoning)
OPENAI_API_KEY=

# Google Fact Check Tools API Key
GOOGLE_FACT_CHECK_API_KEY=

# Custom FFmpeg Path (Optional; auto-detected from system or ./bin/ffmpeg.exe)
FFMPEG_PATH=

# Audio Pipeline Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_LOW_LATENCY_FFMPEG=True
