# VeriStream Configuration

# Server Port
PORT=3000

# OpenAI API Key (Optional - for OpenAI Whisper & GPT Claim Extraction)
# If omitted, VeriStream uses its built-in heuristic claim extraction & simulated/client audio STT
OPENAI_API_KEY=

# Google Fact Check Tools API Key (Optional)
# If omitted, VeriStream queries the public API if accessible or uses its curated verification knowledge-base
GOOGLE_FACT_CHECK_API_KEY=

# Path to custom FFmpeg binary (Optional - defaults to @ffmpeg-installer/ffmpeg)
FFMPEG_PATH=

# Real-Time Pipeline Optimization Settings
STREAM_CHUNK_DURATION_SEC=4
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
ENABLE_LOW_LATENCY_FFMPEG=true
